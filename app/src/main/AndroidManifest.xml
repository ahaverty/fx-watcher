<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- To watch the pump's Bluetooth link (it does not scan or connect to anything). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Optional: Google sleep detection for bedtime media volume (asked only if switched on). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Self-update from the latest GitHub release (Android asks before installing). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Optional bolus broadcast (BolusBroadcast): apps that want it ask for this permission. -->
    <permission
        android:name="studio.alans.fxwatcher.permission.RECEIVE_BOLUS"
        android:label="Receive boluses from FX Watcher"
        android:description="@string/perm_receive_bolus"
        android:protectionLevel="normal" />

    <!-- Lets the app see CamAPS FX: needed to draw its notification layout and to relaunch it. -->
    <queries>
        <package android:name="com.camdiab.fx_alert.mmoll" />
        <package android:name="com.camdiab.fx_alert.mgdl" />
        <package android:name="com.camdiab.fx_alert.hx.mmoll" />
        <package android:name="com.camdiab.fx_alert.hx.mgdl" />
        <!-- Only to tailor the quiet event walkthrough (Quiet.guide) to what is installed. -->
        <package android:name="com.dexcom.g7" />
        <package android:name="com.eveningoutpost.dexdrip" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.google.android.wearable.app" />
        <package android:name="com.samsung.android.app.watchmanager" />
        <!-- Apps that listen for the optional bolus broadcast. -->
        <intent>
            <action android:name="studio.alans.fxwatcher.action.BOLUS" />
        </intent>
    </queries>

    <application
        android:label="FX Watcher"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- Android Auto shows messaging-style notifications from apps that declare this. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="studio.alans.fxwatcher.alarm" />

        <service
            android:name=".CamapsListener"
            android:exported="true"
            android:label="FX Watcher"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Optional, off until enabled in Accessibility settings. Reads the CamAPS screen only. -->
        <service
            android:name=".CamapsReader"
            android:exported="false"
            android:label="@string/reader_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/camaps_reader" />
        </service>

        <!-- Google sleep detection events (bedtime media volume, optional). -->
        <!-- Opt-in: an app holding the bolus permission asks for CamAPS's Bolus tab (BolusTab). -->
        <receiver
            android:name=".BolusTab"
            android:exported="true"
            android:permission="studio.alans.fxwatcher.permission.RECEIVE_BOLUS">
            <intent-filter>
                <action android:name="studio.alans.fxwatcher.action.OPEN_BOLUS_TAB" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".SleepReceiver"
            android:exported="false" />

        <!-- Notification buttons, Android Auto replies and the watchdog timer. -->
        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".SystemReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Pump Bluetooth link up/down (these broadcasts still reach manifest receivers). -->
        <receiver
            android:name=".BtReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Snooze sync from the Home Assistant companion app (checked against the webhook id). -->
        <receiver
            android:name=".HaReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="studio.alans.fxwatcher.HA_SNOOZE" />
                <action android:name="studio.alans.fxwatcher.HA_NUDGE" />
            </intent-filter>
        </receiver>

        <!-- Self-update install progress (asks the user to confirm). -->
        <receiver
            android:name=".Updater$InstallStatus"
            android:exported="false" />

        <!-- Test hooks for adb only (the shell holds DUMP, other apps do not). -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
