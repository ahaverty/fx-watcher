<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_teal"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/carb_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Carbs to CamAPS"
        android:textColor="#FFB0B4B8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/carb_1"
            style="@style/CarbButton" />

        <TextView
            android:id="@+id/carb_2"
            style="@style/CarbButton" />

        <TextView
            android:id="@+id/carb_3"
            style="@style/CarbButton" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/carb_4"
            style="@style/CarbButton" />

        <TextView
            android:id="@+id/carb_5"
            style="@style/CarbButton" />

        <TextView
            android:id="@+id/carb_6"
            style="@style/CarbButton" />
    </LinearLayout>
</LinearLayout>
