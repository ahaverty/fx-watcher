<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_teal"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/cc_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cc_dot"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/calm_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cc_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Steady"
                android:textColor="#FF1FA89A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cc_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nothing needs you"
                android:textColor="#FF9AA3AD"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cc_q1"
            style="@style/CarbButton" />

        <TextView
            android:id="@+id/cc_q2"
            style="@style/CarbButton" />

        <TextView
            android:id="@+id/cc_q3"
            style="@style/CarbButton" />

        <TextView
            android:id="@+id/cc_q4"
            style="@style/CarbButton" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/carb_stepper"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cc_down"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="\u2212"
            android:textColor="#FF1FA89A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cc_amount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:gravity="center"
            android:text="20 g"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cc_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+"
            android:textColor="#FF1FA89A"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/cc_set"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="3dp"
        android:background="@drawable/carb_set"
        android:gravity="center"
        android:text="Set 20 g in CamAPS"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
