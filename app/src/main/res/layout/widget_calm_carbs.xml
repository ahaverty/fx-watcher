<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_teal"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/cc_status"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cc_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/calm_dot" />

        <TextView
            android:id="@+id/cc_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Steady"
            android:textColor="#FF1FA89A"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/cc_c1"
        style="@style/QuickChip" />

    <TextView
        android:id="@+id/cc_c2"
        style="@style/QuickChip" />

    <TextView
        android:id="@+id/cc_c3"
        style="@style/QuickChip" />

    <TextView
        android:id="@+id/cc_more"
        style="@style/QuickChip"
        android:layout_width="34dp"
        android:layout_weight="0"
        android:background="@drawable/chip_more"
        android:text="\u22EF"
        android:textSize="20sp" />
</LinearLayout>
